# Load libraries
library(readr)
library(dplyr)
library(lubridate)
library(tseries)
library(rugarch)
library(FinTS)

# Import data
zse <- read_csv("data/ZSE_All_Share_Historical_Data.csv")

# Data preprocessing
zse <- zse %>%
  mutate(
    Date = mdy(Date),
    Return = log(Price / lag(Price))
  )

# Plot returns
png("output/returns_plot.png")
plot(zse$Date, zse$Return, type="l",
     main="ZSE Log Returns",
     xlab="Date",
     ylab="Returns")
dev.off()

# Stationarity test
adf_result <- adf.test(na.omit(zse$Return))
print(adf_result)

# ARCH effect test
arch_test <- ArchTest(na.omit(zse$Return), lags=12)
print(arch_test)

# Specify GARCH(1,1)
spec <- ugarchspec(
  variance.model=list(model="sGARCH", garchOrder=c(1,1)),
  mean.model=list(armaOrder=c(0,0)),
  distribution.model="norm"
)

# Fit model
fit <- ugarchfit(spec, data=na.omit(zse$Return))
show(fit)

# Plot volatility
png("output/conditional_volatility.png")
plot(sigma(fit), type="l",
     main="Estimated Volatility (GARCH Model)",
     ylab="Volatility")
dev.off()
